                     transfer-ownership="full"
                     optional="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gio/gmenumodel.c"
                 line="864">the linked #GMenuModel</doc>
            <type name="MenuModel" c:type="GMenuModel**"/>
