          <doc xml:space="preserve"
               filename="gio/gfile.c"
               line="762">0 if @file is not a valid #GFile, otherwise an
  integer that can be used as hash value for the #GFile.
  This function is intended for easily hashing a #GFile to
  add to a #GHashTable or similar data structure.</doc>
          <type name="guint" c:type="guint"/>
        </return-value>
        <parameters>
          <instance-parameter name="file" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gfile.c"
                 line="756">#gconstpointer to a #GFile</doc>
            <type name="File" c:type="gconstpointer"/>
          </instance-parameter>
