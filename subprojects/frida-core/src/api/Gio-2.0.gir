                 filename="gio/gconverter.c"
                 line="64">the number of bytes in @outbuf, must be at least one</doc>
            <type name="gsize" c:type="gsize"/>
          </parameter>
          <parameter name="flags" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gconverter.c"
                 line="65">a #GConverterFlags controlling the conversion details</doc>
            <type name="ConverterFlags" c:type="GConverterFlags"/>
          </parameter>
          <parameter name="bytes_read"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full">
            <doc xml:space="preserve"
                 filename="gio/gconverter.c"
                 line="66">will be set to the number of bytes read
