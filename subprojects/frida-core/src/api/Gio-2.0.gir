                 filename="gio/gnetworkmonitor.c"
                 line="185">a #GCancellable, or %NULL</doc>
            <type name="Cancellable" c:type="GCancellable*"/>
          </parameter>
        </parameters>
      </virtual-method>
      <virtual-method name="can_reach_async"
                      invoker="can_reach_async"
                      glib:finish-func="can_reach_finish"
