                 line="1562">a #GOutputStream</doc>
            <type name="OutputStream" c:type="GOutputStream*"/>
          </instance-parameter>
          <parameter name="result" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/goutputstream.c"
                 line="1563">a #GAsyncResult</doc>
            <type name="AsyncResult" c:type="GAsyncResult*"/>
          </parameter>
          <parameter name="bytes_written"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full"
                     optional="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gio/goutputstream.c"
                 line="1564">location to store the number of bytes that were written to the stream</doc>
            <type name="gsize" c:type="gsize*"/>
