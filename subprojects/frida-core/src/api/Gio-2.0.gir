            <type name="gsize" c:type="gsize*"/>
          </parameter>
          <parameter name="bytes_written"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full">
            <doc xml:space="preserve"
                 filename="gio/gconverter.c"
                 line="68">will be set to the number of bytes
   written to @outbuf on success</doc>
            <type name="gsize" c:type="gsize*"/>
          </parameter>
        </parameters>
      </virtual-method>
