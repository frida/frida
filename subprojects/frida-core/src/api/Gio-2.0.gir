              <type name="filename"/>
            </array>
          </parameter>
          <parameter name="flags" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gsubprocess.c"
                 line="600">flags that define the behaviour of the subprocess</doc>
            <type name="SubprocessFlags" c:type="GSubprocessFlags"/>
