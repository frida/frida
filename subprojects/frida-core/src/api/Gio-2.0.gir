            <doc xml:space="preserve"
                 filename="gio/gsocket.c"
                 line="3857">a #GSocket</doc>
            <type name="Socket" c:type="GSocket*"/>
          </instance-parameter>
          <parameter name="shutdown_read" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gsocket.c"
                 line="3858">whether to shut down the read side</doc>
            <type name="gboolean" c:type="gboolean"/>
          </parameter>
          <parameter name="shutdown_write" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gsocket.c"
                 line="3859">whether to shut down the write side</doc>
            <type name="gboolean" c:type="gboolean"/>
          </parameter>
        </parameters>
      </method>
      <method name="speaks_ipv4"
