                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gio/gsettings.c"
                 line="746">
       an array of #GQuarks for the changed keys, or %NULL</doc>
            <array length="1" zero-terminated="0" c:type="gpointer">
              <type name="GLib.Quark"/>
