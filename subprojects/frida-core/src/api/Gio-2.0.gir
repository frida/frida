                 line="6167">a pointer
   which may be filled with an array of #GSocketControlMessages, or %NULL</doc>
            <array length="4"
                   zero-terminated="0"
                   c:type="GSocketControlMessage***">
              <type name="SocketControlMessage"
                    c:type="GSocketControlMessage**"/>
            </array>
          </parameter>
          <parameter name="num_messages"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full">
