      <method name="join_multicast_group"
              c:identifier="g_socket_join_multicast_group"
              version="2.32"
              throws="1">
        <doc xml:space="preserve"
             filename="gio/gsocket.c"
             line="2561">Registers @socket to receive multicast messages sent to @group.
@socket must be a %G_SOCKET_TYPE_DATAGRAM socket, and must have
been bound to an appropriate interface and port with
g_socket_bind().

If @iface is %NULL, the system will automatically pick an interface
to bind to based on @group.

If @source_specific is %TRUE, source-specific multicast as defined
in RFC 4604 is used. Note that on older platforms this may fail
with a %G_IO_ERROR_NOT_SUPPORTED error.

To bind to a given source-specific multicast address, use
g_socket_join_multicast_group_ssm() instead.</doc>
        <source-position filename="gio/gsocket.h" line="151"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gio/gsocket.c"
               line="2584">%TRUE on success, %FALSE on error.</doc>
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
        <parameters>
          <instance-parameter name="socket" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gsocket.c"
                 line="2563">a #GSocket.</doc>
            <type name="Socket" c:type="GSocket*"/>
          </instance-parameter>
          <parameter name="group" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gsocket.c"
                 line="2564">a #GInetAddress specifying the group address to join.</doc>
            <type name="InetAddress" c:type="GInetAddress*"/>
          </parameter>
          <parameter name="source_specific" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gsocket.c"
                 line="2566">%TRUE if source-specific multicast should be used</doc>
            <type name="gboolean" c:type="gboolean"/>
          </parameter>
          <parameter name="iface"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gio/gsocket.c"
                 line="2565">Name of the interface to use, or %NULL</doc>
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
      </method>
      <method name="join_multicast_group_ssm"
              c:identifier="g_socket_join_multicast_group_ssm"
              version="2.56"
              throws="1">
        <doc xml:space="preserve"
             filename="gio/gsocket.c"
             line="2818">Registers @socket to receive multicast messages sent to @group.
@socket must be a %G_SOCKET_TYPE_DATAGRAM socket, and must have
been bound to an appropriate interface and port with
g_socket_bind().

If @iface is %NULL, the system will automatically pick an interface
to bind to based on @group.

If @source_specific is not %NULL, use source-specific multicast as
defined in RFC 4604. Note that on older platforms this may fail
with a %G_IO_ERROR_NOT_SUPPORTED error.

Note that this function can be called multiple times for the same
@group with different @source_specific in order to receive multicast
packets from more than one source.</doc>
