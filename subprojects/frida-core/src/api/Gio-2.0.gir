            <doc xml:space="preserve"
                 filename="gio/gsettingsschema.c"
                 line="757">if we should recurse</doc>
            <type name="gboolean" c:type="gboolean"/>
          </parameter>
          <parameter name="non_relocatable"
                     direction="out"
                     caller-allocates="0"
                     transfer-ownership="full">
            <doc xml:space="preserve"
