      <method name="hash" c:identifier="g_file_hash">
        <doc xml:space="preserve"
             filename="gio/gfile.c"
             line="754">Creates a hash value for a #GFile.

This call does no blocking I/O.</doc>
        <source-position filename="gio/gfile.h" line="648"/>
