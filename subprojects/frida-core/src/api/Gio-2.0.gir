          <instance-parameter name="direnum" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gfileenumerator.c"
                 line="629">an open #GFileEnumerator</doc>
            <type name="FileEnumerator" c:type="GFileEnumerator*"/>
