                 filename="gio/gfile.c"
                 line="3640">input #GFile</doc>
            <type name="File" c:type="GFile*"/>
          </instance-parameter>
          <parameter name="destination" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gfile.c"
                 line="3641">destination #GFile</doc>
