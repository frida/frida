                 filename="gio/gsettingsschema.c"
                 line="248">the filename of a directory</doc>
            <type name="filename" c:type="const gchar*"/>
          </parameter>
          <parameter name="parent"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
