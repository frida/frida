          </instance-parameter>
          <parameter name="index_" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gunixfdlist.c"
                 line="357">the index into the list</doc>
            <type name="gint" c:type="gint"/>
          </parameter>
        </parameters>
      </method>
