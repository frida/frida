      <method name="get_connectivity"
              c:identifier="g_network_monitor_get_connectivity"
              glib:get-property="connectivity"
              version="2.44">
        <doc xml:space="preserve"
             filename="gio/gnetworkmonitor.c"
             line="143">Gets a more detailed networking state than
g_network_monitor_get_network_available().

If #GNetworkMonitor:network-available is %FALSE, then the
connectivity state will be %G_NETWORK_CONNECTIVITY_LOCAL.

If #GNetworkMonitor:network-available is %TRUE, then the
connectivity state will be %G_NETWORK_CONNECTIVITY_FULL (if there
is full Internet connectivity), %G_NETWORK_CONNECTIVITY_LIMITED (if
the host has a default route, but appears to be unable to actually
reach the full Internet), or %G_NETWORK_CONNECTIVITY_PORTAL (if the
host is trapped behind a "captive portal" that requires some sort
of login or acknowledgement before allowing full Internet access).

Note that in the case of %G_NETWORK_CONNECTIVITY_LIMITED and
%G_NETWORK_CONNECTIVITY_PORTAL, it is possible that some sites are
reachable but others are not. In this case, applications can
attempt to connect to remote servers, but should gracefully fall
back to their "offline" behavior if the connection attempt fails.</doc>
        <source-position filename="gio/gnetworkmonitor.h" line="81"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gio/gnetworkmonitor.c"
               line="167">the network connectivity state</doc>
          <type name="NetworkConnectivity" c:type="GNetworkConnectivity"/>
        </return-value>
        <parameters>
          <instance-parameter name="monitor" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gnetworkmonitor.c"
                 line="145">the #GNetworkMonitor</doc>
            <type name="NetworkMonitor" c:type="GNetworkMonitor*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="get_network_available"
              c:identifier="g_network_monitor_get_network_available"
              glib:get-property="network-available"
              version="2.32">
        <doc xml:space="preserve"
             filename="gio/gnetworkmonitor.c"
             line="101">Checks if the network is available. "Available" here means that the
system has a default route available for at least one of IPv4 or
IPv6. It does not necessarily imply that the public Internet is
reachable. See #GNetworkMonitor:network-available for more details.</doc>
        <source-position filename="gio/gnetworkmonitor.h" line="75"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gio/gnetworkmonitor.c"
               line="110">whether the network is available</doc>
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
        <parameters>
          <instance-parameter name="monitor" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gnetworkmonitor.c"
                 line="103">the #GNetworkMonitor</doc>
            <type name="NetworkMonitor" c:type="GNetworkMonitor*"/>
          </instance-parameter>
        </parameters>
      </method>
      <method name="get_network_metered"
              c:identifier="g_network_monitor_get_network_metered"
              glib:get-property="network-metered"
              version="2.46">
        <doc xml:space="preserve"
             filename="gio/gnetworkmonitor.c"
             line="123">Checks if the network is metered.
See #GNetworkMonitor:network-metered for more details.</doc>
        <source-position filename="gio/gnetworkmonitor.h" line="78"/>
        <return-value transfer-ownership="none">
          <doc xml:space="preserve"
               filename="gio/gnetworkmonitor.c"
               line="130">whether the connection is metered</doc>
          <type name="gboolean" c:type="gboolean"/>
        </return-value>
        <parameters>
