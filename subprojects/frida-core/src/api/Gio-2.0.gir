        </return-value>
        <parameters>
          <parameter name="application_id" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gapplication.c"
                 line="1811">a potential application identifier</doc>
            <type name="utf8" c:type="const gchar*"/>
          </parameter>
        </parameters>
      </function>
