            <doc xml:space="preserve"
                 filename="gio/gsocket.c"
                 line="1597">a #GSocket.</doc>
            <type name="Socket" c:type="GSocket*"/>
          </instance-parameter>
          <parameter name="timeout" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gsocket.c"
                 line="1598">the timeout for @socket, in seconds, or 0 for none</doc>
            <type name="guint" c:type="guint"/>
          </parameter>
        </parameters>
      </method>
