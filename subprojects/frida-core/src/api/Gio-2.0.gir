              glib:nick="mx"
              glib:name="G_RESOLVER_RECORD_MX">
        <doc xml:space="preserve"
             filename="gio/gioenums.h"
             line="734">look up DNS MX records for a domain</doc>
      </member>
      <member name="txt"
