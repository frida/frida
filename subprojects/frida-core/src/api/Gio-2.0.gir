      <member name="handle_method_invocations_in_thread"
              value="1"
              c:identifier="G_DBUS_INTERFACE_SKELETON_FLAGS_HANDLE_METHOD_INVOCATIONS_IN_THREAD"
              glib:nick="handle-method-invocations-in-thread"
