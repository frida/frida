      <method name="set_rehandshake_mode"
              c:identifier="g_dtls_connection_set_rehandshake_mode"
              glib:set-property="rehandshake-mode"
              version="2.48"
              deprecated="1"
              deprecated-version="2.60.">
        <doc xml:space="preserve"
             filename="gio/gdtlsconnection.c"
             line="645">Since GLib 2.64, changing the rehandshake mode is no longer supported
and will have no effect. With TLS 1.3, rehandshaking has been removed from
the TLS protocol, replaced by separate post-handshake authentication and
rekey operations.</doc>
        <doc-deprecated xml:space="preserve">Changing the rehandshake mode is no longer
  required for compatibility. Also, rehandshaking has been removed
  from the TLS protocol in TLS 1.3.</doc-deprecated>
        <source-position filename="gio/gdtlsconnection.h" line="144"/>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
