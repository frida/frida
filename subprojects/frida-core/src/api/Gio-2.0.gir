                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gio/gtlsdatabase.c"
                 line="796">used to interact with the user if necessary</doc>
            <type name="TlsInteraction" c:type="GTlsInteraction*"/>
          </parameter>
