               filename="gio/gthemedicon.c"
               line="362">a new #GThemedIcon.</doc>
          <type name="ThemedIcon" c:type="GIcon*"/>
        </return-value>
        <parameters>
          <parameter name="iconname" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gthemedicon.c"
                 line="358">a string containing an icon name.</doc>
