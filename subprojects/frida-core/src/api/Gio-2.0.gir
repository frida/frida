                 filename="gio/gfile.c"
                 line="9020">optional #GCancellable</doc>
            <type name="Cancellable" c:type="GCancellable*"/>
          </parameter>
          <parameter name="progress_callback"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1"
                     scope="call"
                     closure="3">
            <doc xml:space="preserve"
                 filename="gio/gfile.c"
                 line="9021">a #GFileMeasureProgressCallback</doc>
            <type name="FileMeasureProgressCallback"
                  c:type="GFileMeasureProgressCallback"/>
          </parameter>
          <parameter name="progress_data"
                     transfer-ownership="none"
