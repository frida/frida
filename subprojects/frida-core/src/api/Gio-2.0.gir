      <method name="attach_source"
              c:identifier="g_task_attach_source"
              version="2.36"
              introspectable="0">
        <doc xml:space="preserve"
             filename="gio/gtask.c"
             line="1772">A utility function for dealing with async operations where you need
to wait for a #GSource to trigger. Attaches @source to @task's
#GMainContext with @task's [priority](iface.AsyncResult.html#io-priority),
and sets @source's callback to @callback, with @task as the callback's
`user_data`.

It will set the @source’s name to the task’s name (as set with
g_task_set_name()), if one has been set on the task and the source doesn’t
yet have a name.

This takes a reference on @task until @source is destroyed.</doc>
        <source-position filename="gio/gtask.h" line="147"/>
        <return-value transfer-ownership="none">
          <type name="none" c:type="void"/>
        </return-value>
        <parameters>
          <instance-parameter name="task" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gtask.c"
                 line="1774">a #GTask</doc>
            <type name="Task" c:type="GTask*"/>
          </instance-parameter>
          <parameter name="source" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gtask.c"
                 line="1775">the source to attach</doc>
            <type name="GLib.Source" c:type="GSource*"/>
          </parameter>
          <parameter name="callback" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gtask.c"
                 line="1776">the callback to invoke when @source triggers</doc>
            <type name="GLib.SourceFunc" c:type="GSourceFunc"/>
          </parameter>
        </parameters>
      </method>
