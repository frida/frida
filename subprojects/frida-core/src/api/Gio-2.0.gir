                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gio/gtask.c"
                 line="1088">an opaque pointer indicating the source of this task</doc>
            <type name="gpointer" c:type="gpointer"/>
          </parameter>
        </parameters>
      </method>
      <method name="set_static_name"
              c:identifier="g_task_set_static_name"
              version="2.76">
