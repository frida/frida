                 filename="gio/gsocket.c"
                 line="3406">a #GSocket</doc>
            <type name="Socket" c:type="GSocket*"/>
          </instance-parameter>
          <parameter name="size" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gsocket.c"
                 line="3407">the number of bytes you want to read from the socket</doc>
            <type name="gsize" c:type="gsize"/>
          </parameter>
          <parameter name="timeout_us" transfer-ownership="none">
            <doc xml:space="preserve"
                 filename="gio/gsocket.c"
                 line="3408">the timeout to wait for, in microseconds, or `-1` to block
  indefinitely</doc>
            <type name="gint64" c:type="gint64"/>
          </parameter>
          <parameter name="cancellable"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
