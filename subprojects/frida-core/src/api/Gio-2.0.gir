          </instance-parameter>
          <parameter name="protocols"
                     transfer-ownership="none"
                     nullable="1"
                     allow-none="1">
            <doc xml:space="preserve"
                 filename="gio/gtlsconnection.c"
                 line="811">a %NULL-terminated
  array of ALPN protocol names (eg, "http/1.1", "h2"), or %NULL</doc>
