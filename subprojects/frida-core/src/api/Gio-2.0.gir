             line="2001">stdin is inherited from the
  calling process.</doc>
      </member>
      <member name="stdout_pipe"
              value="4"
              c:identifier="G_SUBPROCESS_FLAGS_STDOUT_PIPE"
              glib:nick="stdout-pipe"
              glib:name="G_SUBPROCESS_FLAGS_STDOUT_PIPE">
        <doc xml:space="preserve"
             filename="gio/gioenums.h"
             line="2003">create a pipe for the stdout of the
  spawned process that can be accessed with
  g_subprocess_get_stdout_pipe().</doc>
      </member>
      <member name="stdout_silence"
              value="8"
              c:identifier="G_SUBPROCESS_FLAGS_STDOUT_SILENCE"
              glib:nick="stdout-silence"
              glib:name="G_SUBPROCESS_FLAGS_STDOUT_SILENCE">
        <doc xml:space="preserve"
             filename="gio/gioenums.h"
             line="2006">silence the stdout of the spawned
